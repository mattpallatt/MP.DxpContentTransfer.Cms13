<?xml version="1.0" encoding="utf-8"?>
<!--
  Shipped as an ASP.NET Core static web asset (see the csproj's StaticWebAssetBasePath) so it
  lands at the DEFAULT ProtectedModuleOptions.RootPath ("~/ui") in any app that references this
  package or project — no manual file placement required for the common case. See CLAUDE.md
  ("CMS 13 shell integration") for what this fixes and the one documented exception (a host that
  remaps RootPath, e.g. via Jhoose.Security).

  loadFromBin="false" matters: "true" makes ModuleFinder look for the DLL under a nested bin/
  subfolder relative to the module's own directory, which doesn't exist in a normal NuGet/ASP.NET
  Core consuming app — the assembly lives in the app's own shared output folder instead.
-->
<module loadFromBin="false">
  <assemblies>
    <add assembly="DxpContentTransfer.Cms13" />
  </assemblies>
  <clientModule>
    <moduleDependencies>
      <add dependency="CMS" />
    </moduleDependencies>
  </clientModule>
</module>
